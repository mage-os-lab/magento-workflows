<?xml version="1.0"?>
<!-- Merges the cart-abandonment threshold into the engine's
     mageos_workflows/scheduler group (same section/group/field ids so Magento
     merges it into the existing Scheduler group). The field lives here because
     AbandonedCartDetector (this pack) owns it; the config path
     mageos_workflows/scheduler/abandoned_hours is unchanged (domain-packs S6). -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mageos_workflows">
            <group id="scheduler">
                <field id="abandoned_hours" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Cart Abandonment Threshold (hours)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
