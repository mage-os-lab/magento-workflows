<?xml version="1.0"?>
<!--
/**
 * Customer async-event definition (relocated from
 * mage-os/workflows-triggers-core, domain-packs S2). The service class/method
 * hydrates the delivered payload from the id in the published data;
 * publisher-supplied extra keys (from_group_id/to_group_id) ride along.
 *
 * Publisher: Observer\CustomerGroupChangeObserver (this module) publishes
 * customer.group_changed.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_AsyncEvents:etc/async_events.xsd">
    <async_event name="customer.group_changed">
        <service class="Magento\Customer\Api\CustomerRepositoryInterface" method="getById"/>
    </async_event>
</config>
