<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mageos_workflows>
            <scheduler>
                <!-- Per-run match cap for schedule-type workflows (docs/05-triggers.md#scheduled-triggers-workflows-scheduler) -->
                <match_cap>5000</match_cap>
                <!-- abandoned_hours moved with AbandonedCartDetector to mage-os/workflows-sales (domain-packs S1) -->
                <!-- StockThresholdDetector: fire when qty is at or below this value; 0 or empty disables the detector -->
                <stock_threshold>5</stock_threshold>
            </scheduler>
        </mageos_workflows>
    </default>
</config>
