<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Evaluates every schedule-type workflow's cron expression against its store timezone;
             docs/05-triggers.md#scheduled-triggers-workflows-scheduler -->
        <job name="mageos_workflows_scheduler" instance="MageOS\WorkflowsScheduler\Cron\RunScheduledWorkflows" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <!-- The abandoned-cart query trigger (mageos_workflows_abandoned_carts /
             AbandonedCartDetector) moved to mage-os/workflows-sales (domain-packs S1). -->
        <!-- The stock-threshold query trigger (mageos_workflows_stock_threshold /
             StockThresholdDetector) moved to mage-os/workflows-inventory (domain-packs S4). -->
    </group>
</config>
