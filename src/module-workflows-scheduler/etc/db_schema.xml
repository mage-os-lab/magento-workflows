<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="mageos_workflow_schedule_state" resource="default" engine="innodb"
           comment="Per-workflow last-run bookkeeping for schedule-type workflows - double-fire guard and watermark">
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" identity="false"
                comment="Workflow ID (mageos_workflow.workflow_id)"/>
        <column xsi:type="timestamp" name="last_run_at" on_update="false" nullable="true"
                comment="UTC timestamp (minute precision) this workflow last fired - avoids double-fires within the same minute"/>
        <column xsi:type="varchar" name="last_run_watermark" nullable="true" length="32"
                comment="High-water mark (created_at for sales_order, updated_at otherwise) of the last entity dispatched"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="workflow_id"/>
        </constraint>
        <!-- CASCADE like every other child table of mageos_workflow: without
             it a deleted workflow orphans its watermark row, and a reused
             workflow_id silently inherits the old watermark — skipping every
             entity older than a schedule the new workflow never ran. -->
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_SCHEDULE_STATE_WORKFLOW_ID"
                    table="mageos_workflow_schedule_state" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
    </table>

    <!-- mageos_workflow_abandoned_flag moved to mage-os/workflows-sales with the
         AbandonedCartDetector (domain-packs S1). -->

</schema>
