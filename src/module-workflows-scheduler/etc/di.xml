<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Entity type => repository map consumed by QueryRunner. Keys must match
        MageOS\Workflows\Api\Data\WorkflowInterface::ENTITY_TYPE values used by
        schedule-type workflows (docs/03-domain-model.md).
    -->
    <type name="MageOS\WorkflowsScheduler\Model\QueryRunner">
        <arguments>
            <argument name="repositories" xsi:type="array">
                <!-- sales_order + quote relocated to mage-os/workflows-sales (domain-packs S1);
                     customer to mage-os/workflows-customer (domain-packs S2);
                     catalog_product to mage-os/workflows-catalog (domain-packs S3). -->
            </argument>
            <!-- DTO interfaces for EntityDataConverter's converter path (05 B1
                 collected mode). Models/DTOs exposing getData()/__toArray()
                 ignore it; declared here so pure-DTO entity types still lift
                 EAV/extension attributes to the same shape B2 produces. -->
            <argument name="dtoInterfaces" xsi:type="array">
                <!-- sales_order + quote relocated to mage-os/workflows-sales (domain-packs S1);
                     customer to mage-os/workflows-customer (domain-packs S2);
                     catalog_product to mage-os/workflows-catalog (domain-packs S3). -->
            </argument>
        </arguments>
    </type>

    <!--
        Save-time cron syntax for schedule-type workflows, appended to the
        engine's ordered check pool (F2). The check lives here because the
        parse authority — dragonmantank/cron-expression — is this package's
        dependency, not the engine's; DI merges the array across modules, the
        same way the domain packs append hydrators and option sources.
        Deliberately NOT added to WorkflowValidatorForDryRun: dry-run judges a
        definition, not the workflow's schedule.
    -->
    <type name="MageOS\Workflows\Model\Validation\WorkflowValidator">
        <arguments>
            <argument name="checks" xsi:type="array">
                <item name="cron_expression" xsi:type="object">MageOS\WorkflowsScheduler\Model\Validation\CronExpressionCheck</item>
            </argument>
        </arguments>
    </type>
</config>
