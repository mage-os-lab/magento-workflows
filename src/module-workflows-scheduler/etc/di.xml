<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Entity type => repository map consumed by QueryRunner. Keys must match
        MageOS\Workflows\Api\Data\WorkflowInterface::ENTITY_TYPE values used by
        schedule-type workflows (docs/03-domain-model.md).
    -->
    <type name="MageOS\WorkflowsScheduler\Model\QueryRunner">
        <arguments>
            <argument name="repositories" xsi:type="array">
                <item name="sales_order" xsi:type="object">Magento\Sales\Api\OrderRepositoryInterface</item>
                <item name="customer" xsi:type="object">Magento\Customer\Api\CustomerRepositoryInterface</item>
                <item name="catalog_product" xsi:type="object">Magento\Catalog\Api\ProductRepositoryInterface</item>
                <item name="quote" xsi:type="object">Magento\Quote\Api\CartRepositoryInterface</item>
            </argument>
            <!-- DTO interfaces for EntityDataConverter's converter path (05 B1
                 collected mode). Models/DTOs exposing getData()/__toArray()
                 ignore it; declared here so pure-DTO entity types still lift
                 EAV/extension attributes to the same shape B2 produces. -->
            <argument name="dtoInterfaces" xsi:type="array">
                <item name="sales_order" xsi:type="string">Magento\Sales\Api\Data\OrderInterface</item>
                <item name="customer" xsi:type="string">Magento\Customer\Api\Data\CustomerInterface</item>
                <item name="catalog_product" xsi:type="string">Magento\Catalog\Api\Data\ProductInterface</item>
                <item name="quote" xsi:type="string">Magento\Quote\Api\Data\CartInterface</item>
            </argument>
        </arguments>
    </type>
</config>
