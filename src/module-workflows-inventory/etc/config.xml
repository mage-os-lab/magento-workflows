<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mageos_workflows>
            <scheduler>
                <!-- StockThresholdDetector: fire when qty is at or below this value; 0 or empty
                     disables the detector. Path preserved (mageos_workflows/scheduler/stock_threshold);
                     relocated with the detector from mage-os/workflows-scheduler (domain-packs S4). -->
                <stock_threshold>5</stock_threshold>
            </scheduler>
        </mageos_workflows>
    </default>
</config>
