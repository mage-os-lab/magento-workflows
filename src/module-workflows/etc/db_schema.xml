<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        JSON payload columns are declared `mediumtext`, never `xsi:type="json"`.

        MariaDB implements JSON as an alias for LONGTEXT plus an automatic
        CHECK (json_valid(col)) constraint, so `information_schema.COLUMNS.DATA_TYPE`
        reads back `longtext`. Magento's declarative-schema differ instantiates the
        declared column through Dto\Factories\Json (-> Dto\Columns\Blob) and the
        introspected one through Dto\Factories\LongText (-> Dto\Columns\Text), and
        Comparator::compare() starts with get_class($first) === get_class($second).
        Blob !== Text, so a `json` column can never compare equal on MariaDB: every
        `setup:db:status` reports a modify_column that `setup:upgrade` cannot clear.
        `mediumtext` maps to Dto\Columns\Text on both sides and round-trips cleanly.
        See issue #25.
    -->
    <table name="mageos_workflow" resource="default" engine="innodb" comment="Mage-OS Workflow Definitions">
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" identity="true"
                comment="Workflow ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Workflow Name"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" default="0"
                comment="Status (0 disabled, 1 enabled, 2 shadow, 3 suspended)"/>
        <column xsi:type="varchar" name="trigger_type" length="32" nullable="false"
                comment="Trigger Type (event|schedule|manual)"/>
        <column xsi:type="varchar" name="trigger_ref" length="255" nullable="false"
                comment="Trigger Reference (async event name or cron expression)"/>
        <column xsi:type="varchar" name="entity_type" length="64" nullable="false"
                comment="Entity Type (sales_order, customer, catalog_product, ...)"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true"
                comment="Serialized Rule Condition Tree"/>
        <column xsi:type="mediumtext" name="definition" nullable="false" comment="Step Graph Definition JSON"/>
        <column xsi:type="mediumtext" name="aggregation" nullable="true"
                comment="Batch Aggregation Config JSON (05); null = per-entity workflow, non-null = aggregated"/>
        <column xsi:type="int" name="version" unsigned="true" nullable="false" default="1"
                comment="Definition Version"/>
        <column xsi:type="smallint" name="loop_guard_depth" unsigned="true" nullable="false" default="1"
                comment="Loop Guard Depth"/>
        <column xsi:type="mediumtext" name="fan_out" nullable="true"
                comment="Trigger-Level Fan-Out Config JSON {relation, cap}; null = no fan-out (F1)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="workflow_id"/>
        </constraint>
        <index referenceId="MAGEOS_WORKFLOW_STATUS_TRIGGER_TYPE" indexType="btree">
            <column name="status"/>
            <column name="trigger_type"/>
        </index>
    </table>

    <table name="mageos_workflow_website" resource="default" engine="innodb"
           comment="Mage-OS Workflow To Website Link">
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" comment="Workflow ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="workflow_id"/>
            <column name="website_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_WEBSITE_WORKFLOW_ID"
                    table="mageos_workflow_website" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_WEBSITE_WEBSITE_ID"
                    table="mageos_workflow_website" column="website_id"
                    referenceTable="store_website" referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="MAGEOS_WORKFLOW_WEBSITE_WEBSITE_ID" indexType="btree">
            <column name="website_id"/>
        </index>
    </table>

    <table name="mageos_workflow_revision" resource="default" engine="innodb"
           comment="Mage-OS Workflow Revision Archive (prior definitions, change-history UI)">
        <column xsi:type="int" name="revision_id" unsigned="true" nullable="false" identity="true"
                comment="Revision ID"/>
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" comment="Workflow ID"/>
        <column xsi:type="int" name="version" unsigned="true" nullable="false" comment="Archived Definition Version"/>
        <column xsi:type="mediumtext" name="definition" nullable="false" comment="Archived Step Graph Definition JSON"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true"
                comment="Archived Serialized Rule Condition Tree"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Archived At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="revision_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_REVISION_WORKFLOW_ID_VERSION">
            <column name="workflow_id"/>
            <column name="version"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_REVISION_WORKFLOW_ID"
                    table="mageos_workflow_revision" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
    </table>

    <table name="mageos_workflow_execution" resource="default" engine="innodb"
           comment="Mage-OS Workflow Executions (runtime instance per trigger firing)">
        <column xsi:type="bigint" name="execution_id" unsigned="true" nullable="false" identity="true"
                comment="Execution ID"/>
        <column xsi:type="varchar" name="uuid" length="36" nullable="false"
                comment="Execution UUID (correlates with async-events trace UUID)"/>
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" comment="Workflow ID"/>
        <column xsi:type="int" name="workflow_version" unsigned="true" nullable="false"
                comment="Workflow Definition Version Pinned At Trigger Time"/>
        <column xsi:type="mediumtext" name="definition_snapshot" nullable="false"
                comment="Full Definition JSON Snapshot Pinned At Trigger Time"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Subject Entity ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false"
                comment="Status (pending|running|waiting|complete|skipped|failed|cancelled)"/>
        <column xsi:type="varchar" name="trigger_type" length="16" nullable="true"
                comment="Trigger Type That Dispatched This Execution (event|schedule|manual); null on legacy rows"/>
        <column xsi:type="varchar" name="mode" length="16" nullable="false" default="live"
                comment="Execution Mode (live|dry_run) — dry-run feature marker only, NOT a side-effect predicate"/>
        <column xsi:type="mediumtext" name="context" nullable="true"
                comment="Context Variable Bag JSON (trigger snapshot + step outputs)"/>
        <column xsi:type="smallint" name="chain_depth" unsigned="true" nullable="false" default="0"
                comment="Chain Depth (loop guard)"/>
        <column xsi:type="varchar" name="current_step" length="64" nullable="true" comment="Current Step Key"/>
        <column xsi:type="varchar" name="waiting_event" length="128" nullable="true"
                comment="Event Name A Wait Step Parked This Execution On"/>
        <column xsi:type="varchar" name="origin_uuid" length="36" nullable="true"
                comment="Async-Events Trace UUID Of The Causing Event (fan-out children); null otherwise (F1)"/>
        <column xsi:type="timestamp" name="triggered_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Triggered At"/>
        <column xsi:type="timestamp" name="completed_at" on_update="false" nullable="true" comment="Completed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="execution_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_EXECUTION_WORKFLOW_ID"
                    table="mageos_workflow_execution" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_WORKFLOW_ID_STATUS" indexType="btree">
            <column name="workflow_id"/>
            <column name="status"/>
        </index>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_UUID" indexType="btree">
            <column name="uuid"/>
        </index>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_STATUS_TRIGGERED_AT" indexType="btree">
            <column name="status"/>
            <column name="triggered_at"/>
        </index>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_WAIT_MATCH" indexType="btree">
            <column name="status"/>
            <column name="waiting_event"/>
            <column name="entity_id"/>
        </index>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_ORIGIN_UUID" indexType="btree">
            <column name="origin_uuid"/>
        </index>
        <!-- Retention pruning (Cron/PruneExecutions) needs BOTH of these: the
             general pass filters on completed_at alone, and MariaDB cannot use
             the composite below without its leading column, while the dry-run
             pass filters on (mode, completed_at). Without them each nightly
             batch is a full-table scan over mediumtext-carrying rows. -->
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_COMPLETED_AT" indexType="btree">
            <column name="completed_at"/>
        </index>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_MODE_COMPLETED_AT" indexType="btree">
            <column name="mode"/>
            <column name="completed_at"/>
        </index>
    </table>

    <table name="mageos_workflow_execution_step" resource="default" engine="innodb"
           comment="Mage-OS Workflow Execution Steps (per-step runtime state)">
        <column xsi:type="bigint" name="step_execution_id" unsigned="true" nullable="false" identity="true"
                comment="Step Execution ID"/>
        <column xsi:type="bigint" name="execution_id" unsigned="true" nullable="false" comment="Execution ID"/>
        <column xsi:type="varchar" name="step_key" length="64" nullable="false" comment="Step Key"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false"
                comment="Status (pending|running|waiting|complete|failed|skipped)"/>
        <column xsi:type="mediumtext" name="result" nullable="true" comment="Action Output JSON"/>
        <column xsi:type="text" name="error" nullable="true" comment="Error Message"/>
        <column xsi:type="timestamp" name="resume_at" on_update="false" nullable="true"
                comment="Resume At (delay steps)"/>
        <column xsi:type="timestamp" name="claimed_at" on_update="false" nullable="true"
                comment="Claimed At (sweeper worker claim)"/>
        <column xsi:type="timestamp" name="started_at" on_update="false" nullable="true" comment="Started At"/>
        <column xsi:type="timestamp" name="finished_at" on_update="false" nullable="true" comment="Finished At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="step_execution_id"/>
        </constraint>
        <!-- One row per (execution, step) — the identity every writer already
             assumes. Executor::upsertStepRow used to be a SELECT-then-INSERT,
             which two concurrent consumers (a queue redelivery racing a zombie
             republish) could both lose: two rows for one step, after which a
             LIMIT 1 reader picks arbitrarily. The constraint makes the upsert
             an atomic INSERT ... ON DUPLICATE KEY UPDATE and makes every
             (execution_id, step_key) read provably single-row. Pre-release
             software: no data migration for hypothetical duplicates — a fresh
             install has none, and any dev row that dupes fails the DDL loudly
             rather than being silently merged.
             It also subsumes the former single-column execution_id index
             (leading-column prefix), so that index is gone; the whitelist keeps
             its entry so setup:upgrade drops it on existing dev databases. -->
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_EXECUTION_STEP_EXECUTION_ID_STEP_KEY">
            <column name="execution_id"/>
            <column name="step_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_EXECUTION_STEP_EXECUTION_ID"
                    table="mageos_workflow_execution_step" column="execution_id"
                    referenceTable="mageos_workflow_execution" referenceColumn="execution_id" onDelete="CASCADE"/>
        <index referenceId="MAGEOS_WORKFLOW_EXECUTION_STEP_STATUS_RESUME_AT" indexType="btree">
            <column name="status"/>
            <column name="resume_at"/>
        </index>
    </table>

    <table name="mageos_workflow_debounce" resource="default" engine="innodb"
           comment="Mage-OS Workflow Debounce Slots (atomic via unique key)">
        <column xsi:type="bigint" name="debounce_id" unsigned="true" nullable="false" identity="true"
                comment="Debounce ID"/>
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" comment="Workflow ID"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Subject Entity ID"/>
        <column xsi:type="varchar" name="time_bucket" length="64" nullable="false"
                comment="Debounce Time Bucket (e.g. floor(unixtime / window))"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="debounce_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_DEBOUNCE_WORKFLOW_ID_ENTITY_ID_TIME_BUCKET">
            <column name="workflow_id"/>
            <column name="entity_id"/>
            <column name="time_bucket"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_DEBOUNCE_WORKFLOW_ID"
                    table="mageos_workflow_debounce" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
        <!-- Cron/PruneExecutions sweeps expired slots by created_at nightly -->
        <index referenceId="MAGEOS_WORKFLOW_DEBOUNCE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="mageos_workflow_send_log" resource="default" engine="innodb"
           comment="Mage-OS Workflow Send Log (durable at-most-once claims for unrecoverable side effects)">
        <column xsi:type="bigint" name="send_log_id" unsigned="true" nullable="false" identity="true"
                comment="Send Log ID"/>
        <column xsi:type="varchar" name="claim_key" length="191" nullable="false"
                comment="Claim Key (action scope + execution dedupe key: '&lt;action code&gt;:&lt;uuid&gt;:&lt;step&gt;')"/>
        <column xsi:type="varchar" name="scope" length="64" nullable="false"
                comment="Claiming Action Code (e.g. notify.email)"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="claimed"
                comment="Status (claimed = attempted, outcome unknown; sent = confirmed handed to the transport)"/>
        <column xsi:type="timestamp" name="claimed_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Claimed At (before the side effect)"/>
        <column xsi:type="timestamp" name="sent_at" on_update="false" nullable="true"
                comment="Confirmed-Sent At; null on a claim whose outcome was never confirmed"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="send_log_id"/>
        </constraint>
        <!-- THE guard. Email cannot be unsent, so the claim must be an atomic
             INSERT that exactly one consumer wins; the previous cache
             check-and-set was non-atomic, per-node on file caches, and erased
             by cache:flush / Redis eviction. No PII lives here on purpose (no
             recipient, no subject): it is a claim ledger, not a mail log. -->
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_SEND_LOG_CLAIM_KEY">
            <column name="claim_key"/>
        </constraint>
        <!-- Cron/PruneExecutions sweeps claims older than the send-log
             retention window by claimed_at. -->
        <index referenceId="MAGEOS_WORKFLOW_SEND_LOG_CLAIMED_AT" indexType="btree">
            <column name="claimed_at"/>
        </index>
    </table>

    <!-- mageos_workflow_stock_flag moved to mage-os/workflows-inventory with the
         StockThresholdDetector (domain-packs S4). -->

    <table name="mageos_workflow_batch" resource="default" engine="innodb"
           comment="Mage-OS Workflow Batches (event-window accumulation, 05 B2)">
        <column xsi:type="bigint" name="batch_id" unsigned="true" nullable="false" identity="true"
                comment="Batch ID"/>
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false" comment="Workflow ID"/>
        <column xsi:type="varchar" name="window_key" length="64" nullable="false"
                comment="Flush-Idempotency Key (schedule: window-start ISO-8601; interval: opening event UTC to seconds)"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="open"
                comment="Status (open|flushing|flushed)"/>
        <column xsi:type="int" name="item_count" unsigned="true" nullable="false" default="0"
                comment="Accumulated Item Count (may exceed the item cap; overflow elides from items[])"/>
        <column xsi:type="int" name="store_id" unsigned="true" nullable="false" default="0"
                comment="Store ID Of The Opening Event"/>
        <column xsi:type="bigint" name="execution_id" unsigned="true" nullable="true"
                comment="Flush Execution ID (recorded BEFORE publish for write-before-publish idempotency)"/>
        <column xsi:type="timestamp" name="opened_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Opened At"/>
        <column xsi:type="timestamp" name="flush_due_at" on_update="false" nullable="false"
                comment="Flush Due At (window close instant)"/>
        <column xsi:type="timestamp" name="flushing_at" on_update="false" nullable="true"
                comment="Claimed-For-Flush At (open->flushing; grace-period retry clock)"/>
        <column xsi:type="timestamp" name="flushed_at" on_update="false" nullable="true"
                comment="Flushed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="batch_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_BATCH_WORKFLOW_ID_WINDOW_KEY">
            <column name="workflow_id"/>
            <column name="window_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_BATCH_WORKFLOW_ID"
                    table="mageos_workflow_batch" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
        <index referenceId="MAGEOS_WORKFLOW_BATCH_STATUS_FLUSH_DUE_AT" indexType="btree">
            <column name="status"/>
            <column name="flush_due_at"/>
        </index>
    </table>

    <table name="mageos_workflow_batch_item" resource="default" engine="innodb"
           comment="Mage-OS Workflow Batch Items (projected, capped entity snapshots, 05 B2)">
        <column xsi:type="bigint" name="batch_item_id" unsigned="true" nullable="false" identity="true"
                comment="Batch Item ID"/>
        <column xsi:type="bigint" name="batch_id" unsigned="true" nullable="false" comment="Batch ID"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" comment="Subject Entity ID"/>
        <column xsi:type="mediumtext" name="snapshot" nullable="true"
                comment="Projected, Capped Entity Snapshot JSON"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="batch_item_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_BATCH_ITEM_BATCH_ID_ENTITY_ID">
            <column name="batch_id"/>
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_BATCH_ITEM_BATCH_ID"
                    table="mageos_workflow_batch_item" column="batch_id"
                    referenceTable="mageos_workflow_batch" referenceColumn="batch_id" onDelete="CASCADE"/>
    </table>

    <table name="mageos_workflow_secret" resource="default" engine="innodb"
           comment="Mage-OS Workflow Secrets (values encrypted at rest)">
        <column xsi:type="int" name="secret_id" unsigned="true" nullable="false" identity="true"
                comment="Secret ID"/>
        <column xsi:type="varchar" name="key" length="128" nullable="false" comment="Secret Key Name"/>
        <column xsi:type="text" name="value" nullable="false" comment="Secret Value (EncryptorInterface-encrypted)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="secret_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_WORKFLOW_SECRET_KEY">
            <column name="key"/>
        </constraint>
    </table>

    <table name="mageos_workflow_template_install" resource="default" engine="innodb"
           comment="Mage-OS Workflow Template Install Provenance (06, F8): installed from template X vN">
        <column xsi:type="int" name="install_id" unsigned="true" nullable="false" identity="true"
                comment="Install ID"/>
        <column xsi:type="int" name="workflow_id" unsigned="true" nullable="false"
                comment="Workflow ID created by the install"/>
        <column xsi:type="varchar" name="template_code" length="128" nullable="false"
                comment="Installed Template Code"/>
        <column xsi:type="varchar" name="template_version" length="64" nullable="false"
                comment="Installed Template Version (fork-on-install; no upgrade path in v1)"/>
        <column xsi:type="mediumtext" name="parameters" nullable="true"
                comment="Parameter Values Snapshot JSON (never secret values; secret params record key names only)"/>
        <column xsi:type="varchar" name="installed_by" length="128" nullable="false" default="system"
                comment="Installer (admin username, or 'system' for CLI/patch)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Installed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="install_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_WF_TPL_INSTALL_WORKFLOW_ID"
                    table="mageos_workflow_template_install" column="workflow_id"
                    referenceTable="mageos_workflow" referenceColumn="workflow_id" onDelete="CASCADE"/>
        <index referenceId="MAGEOS_WORKFLOW_TEMPLATE_INSTALL_WORKFLOW_ID" indexType="btree">
            <column name="workflow_id"/>
        </index>
    </table>
</schema>
