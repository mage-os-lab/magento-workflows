<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mageos" translate="label" sortOrder="400">
            <label>Mage-OS</label>
        </tab>
        <section id="mageos_workflows" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Workflows</label>
            <tab>mageos</tab>
            <resource>MageOS_Workflows::manage</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="suppress_all" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Suppress All Workflow Dispatch</label>
                    <comment>Emergency switch and bulk-operation guard: no new executions are created while enabled.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="guards" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Guards</label>
                <field id="debounce_window_seconds" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Debounce Window (seconds)</label>
                    <comment>Executions for the same workflow and entity within this window collapse to one.</comment>
                    <validate>validate-digits</validate>
                </field>
                <field id="circuit_breaker_threshold" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Circuit Breaker Threshold</label>
                    <comment>Consecutive step failures before a workflow is auto-suspended.</comment>
                    <validate>validate-digits</validate>
                </field>
                <field id="manual_run_cap" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Manual Mass-Run Cap</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
            <group id="retention" translate="label" type="text" sortOrder="30" showInDefault="1">
                <label>Execution Retention</label>
                <field id="days" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Prune Executions After (days)</label>
                    <comment>Execution contexts contain entity snapshots (PII). Lower this to hours-equivalent (fractions unsupported; use 1) for strict containment.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
            <group id="webhook" translate="label" type="text" sortOrder="40" showInDefault="1">
                <label>Webhook Action</label>
                <field id="allow_insecure_http" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Allow Plain HTTP</label>
                    <comment>Discouraged. Webhook steps must also opt in per step.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="private_host_allowlist" translate="label comment" type="textarea" sortOrder="20" showInDefault="1">
                    <label>Private Host Allowlist</label>
                    <comment>Comma-separated hostnames allowed to resolve to private address ranges. Everything else resolving to private, loopback, link-local, or metadata ranges is rejected (SSRF hardening).</comment>
                </field>
                <field id="default_timeout" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Default Timeout (seconds)</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="max_timeout" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>Maximum Timeout (seconds)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
            <group id="scheduler" translate="label" type="text" sortOrder="50" showInDefault="1">
                <label>Scheduler</label>
                <field id="match_cap" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Per-Run Match Cap</label>
                    <comment>Maximum entities a scheduled workflow may dispatch per run.</comment>
                    <validate>validate-digits</validate>
                </field>
                <field id="abandoned_hours" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Cart Abandonment Threshold (hours)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
