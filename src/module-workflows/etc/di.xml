<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Data + service contracts -->
    <preference for="MageOS\Workflows\Api\Data\WorkflowInterface"
                type="MageOS\Workflows\Model\Workflow"/>
    <preference for="MageOS\Workflows\Api\Data\WorkflowExecutionInterface"
                type="MageOS\Workflows\Model\WorkflowExecution"/>
    <preference for="MageOS\Workflows\Api\Data\WorkflowExecutionStepInterface"
                type="MageOS\Workflows\Model\WorkflowExecutionStep"/>
    <preference for="MageOS\Workflows\Api\WorkflowRepositoryInterface"
                type="MageOS\Workflows\Model\WorkflowRepository"/>
    <preference for="MageOS\Workflows\Api\WorkflowExecutionRepositoryInterface"
                type="MageOS\Workflows\Model\WorkflowExecutionRepository"/>

    <!-- Engine -->
    <preference for="MageOS\Workflows\Api\DispatcherInterface"
                type="MageOS\Workflows\Model\Engine\Dispatcher"/>

    <!-- Validate endpoint (F6) -->
    <preference for="MageOS\Workflows\Api\DefinitionValidationInterface"
                type="MageOS\Workflows\Model\Webapi\DefinitionValidation"/>
    <preference for="MageOS\Workflows\Api\Data\DefinitionValidationResultInterface"
                type="MageOS\Workflows\Model\Webapi\DefinitionValidationResult"/>
    <preference for="MageOS\Workflows\Api\Data\ValidationMessageInterface"
                type="MageOS\Workflows\Model\Validation\ValidationMessage"/>

    <!-- Dry-run endpoints (03) -->
    <preference for="MageOS\Workflows\Api\WorkflowDryRunInterface"
                type="MageOS\Workflows\Model\Webapi\WorkflowDryRun"/>
    <preference for="MageOS\Workflows\Api\Data\DryRunResultInterface"
                type="MageOS\Workflows\Model\Webapi\DryRunResult"/>
    <preference for="MageOS\Workflows\Api\Data\DryRunTraceStepInterface"
                type="MageOS\Workflows\Model\Webapi\DryRunTraceStep"/>

    <!-- Secrets -->
    <preference for="MageOS\Workflows\Model\Variable\SecretsProviderInterface"
                type="MageOS\Workflows\Model\Secrets\ConfigSecretsProvider"/>

    <!-- Simulation substrate (F7): a variable resolver whose secrets resolve
         to ***name***. Bound as a named virtualType — never a preference
         swap of the shared production resolver. Consumers: dry-run (03),
         shadow mode behind mageos_workflows/simulation/redact_shadow_secrets. -->
    <virtualType name="MageOS\Workflows\Model\Variable\VariableResolverForDryRun"
                 type="MageOS\Workflows\Model\Variable\VariableResolver">
        <arguments>
            <argument name="secretsProvider" xsi:type="object">MageOS\Workflows\Model\Secrets\RedactingSecretsProvider</argument>
        </arguments>
    </virtualType>
    <type name="MageOS\Workflows\Model\Engine\Executor">
        <arguments>
            <argument name="redactingVariableResolver" xsi:type="object">MageOS\Workflows\Model\Variable\VariableResolverForDryRun</argument>
        </arguments>
    </type>

    <!-- Dry-run (03): the synchronous, side-effect-free walker. The Walker's
         resolver is the redacting virtualType — config interpolation runs
         ahead of the simulation branch, so a shared production resolver would
         materialize real secret values into trace content (guardrail). -->
    <type name="MageOS\Workflows\Model\DryRun\Walker">
        <arguments>
            <argument name="variableResolver" xsi:type="object">MageOS\Workflows\Model\Variable\VariableResolverForDryRun</argument>
        </arguments>
    </type>
    <!-- The dry-run validation subset: Structural + Graph + ActionCodes +
         ConditionsShape. ActionAuthorizationCheck is deliberately absent
         (dry-run is not an authoring path); ProfileCheck is out of scope for
         the preview. -->
    <virtualType name="MageOS\Workflows\Model\Validation\WorkflowValidatorForDryRun"
                 type="MageOS\Workflows\Model\Validation\WorkflowValidator">
        <arguments>
            <argument name="checks" xsi:type="array">
                <item name="structural" xsi:type="object">MageOS\Workflows\Model\Validation\Check\StructuralCheck</item>
                <item name="graph" xsi:type="object">MageOS\Workflows\Model\Validation\Check\GraphCheck</item>
                <item name="action_codes" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ActionCodesCheck</item>
                <item name="conditions_shape" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ConditionsShapeCheck</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageOS\Workflows\Model\DryRun\DryRunService">
        <arguments>
            <argument name="validator" xsi:type="object">MageOS\Workflows\Model\Validation\WorkflowValidatorForDryRun</argument>
        </arguments>
    </type>

    <!-- Save-time validation pipeline (F2): the ordered check pool. The
         before-plugin on the repository is the single chokepoint every
         authoring path funnels through (admin Save, REST, CLI import,
         gallery); the executor parses definition_snapshot directly and
         never re-enters it. -->
    <type name="MageOS\Workflows\Model\Validation\WorkflowValidator">
        <arguments>
            <argument name="checks" xsi:type="array">
                <item name="structural" xsi:type="object">MageOS\Workflows\Model\Validation\Check\StructuralCheck</item>
                <item name="graph" xsi:type="object">MageOS\Workflows\Model\Validation\Check\GraphCheck</item>
                <item name="profile" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ProfileCheck</item>
                <item name="action_codes" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ActionCodesCheck</item>
                <item name="action_authorization" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ActionAuthorizationCheck</item>
                <item name="conditions_shape" xsi:type="object">MageOS\Workflows\Model\Validation\Check\ConditionsShapeCheck</item>
            </argument>
        </arguments>
    </type>
    <type name="MageOS\Workflows\Api\WorkflowRepositoryInterface">
        <plugin name="mageos_workflows_validate_on_save"
                type="MageOS\Workflows\Plugin\ValidateWorkflowOnSave"/>
    </type>

    <!-- Condition engine -->
    <preference for="MageOS\Workflows\Model\Rule\HydrationProviderInterface"
                type="MageOS\Workflows\Model\Rule\HydrationProvider"/>
    <!-- Condition-node types that force hydration regardless of referenced
         attributes (F4). First entry arrives with the RelatedEntity combine
         (entity cross-referencing); extensions append their own. -->
    <type name="MageOS\Workflows\Model\Rule\AttributeClassifier">
        <arguments>
            <argument name="hydrationForcingNodeTypes" xsi:type="array"/>
        </arguments>
    </type>
    <type name="MageOS\Workflows\Model\Rule\ConditionCombinePool">
        <arguments>
            <argument name="combines" xsi:type="array">
                <item name="sales_order" xsi:type="string">MageOS\Workflows\Model\Rule\Condition\Order\Combine</item>
                <item name="customer" xsi:type="string">MageOS\Workflows\Model\Rule\Condition\Customer\Combine</item>
                <item name="catalog_product" xsi:type="string">MageOS\Workflows\Model\Rule\Condition\Product\Combine</item>
                <item name="quote" xsi:type="string">MageOS\Workflows\Model\Rule\Condition\Quote\Combine</item>
            </argument>
        </arguments>
    </type>

    <!-- CLI -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="workflowExport" xsi:type="object">MageOS\Workflows\Console\Command\ExportCommand</item>
                <item name="workflowImport" xsi:type="object">MageOS\Workflows\Console\Command\ImportCommand</item>
                <item name="workflowRun" xsi:type="object">MageOS\Workflows\Console\Command\RunCommand</item>
                <item name="workflowStats" xsi:type="object">MageOS\Workflows\Console\Command\StatsCommand</item>
                <item name="workflowHealth" xsi:type="object">MageOS\Workflows\Console\Command\HealthCommand</item>
            </argument>
        </arguments>
    </type>
</config>
