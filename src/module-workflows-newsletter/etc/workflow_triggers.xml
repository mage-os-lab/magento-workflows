<?xml version="1.0"?>
<!--
/**
 * Newsletter trigger metadata (SUB-T1). newsletter.subscription_changed is
 * declared and published by this module (etc/async_events.xml,
 * Observer\SubscriptionChangeObserver), over the newsletter_subscriber entity
 * root (SUB-C1). Grouped under Marketing.
 */
-->
<triggers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_Workflows:etc/workflow_triggers.xsd">
    <!-- Newsletter -->
    <trigger event="newsletter.subscription_changed" entity="newsletter_subscriber"
             label="Newsletter Subscription Changed" group="Marketing"/>
</triggers>
