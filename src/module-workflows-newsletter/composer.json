    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://github.com/mage-os-lab/magento-workflows",
    "support": {
        "issues": "https://github.com/mage-os-lab/magento-workflows/issues",
        "source": "https://github.com/mage-os-lab/magento-workflows"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "mage-os/workflows": "*",
        "mage-os/workflows-customer": "*",
        "mage-os/workflows-triggers-core": "*",
        "magento/framework": ">=103.0.4",
        "magento/module-newsletter": "*",
        "magento/module-customer": "*",
        "magento/module-rule": "*",
        "magento/module-store": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "MageOS\\WorkflowsNewsletter\\": ""
        }
    }
}
