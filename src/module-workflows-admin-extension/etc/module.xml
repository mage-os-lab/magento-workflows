<!-- Sequence pins load order after the engine (config section + repository it
     reads), the admin UI (routes the strip links target), and Backend (owns
     the page.main.actions container the strip injects into). All three are
     hard requires; the native entity modules (Sales, Customer, Catalog,
     Review) are soft — their layout handles simply never fire when absent. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="MageOS_WorkflowsAdminExtension">
        <sequence>
            <module name="MageOS_Workflows"/>
            <module name="MageOS_WorkflowsAdminUi"/>
            <module name="Magento_Backend"/>
        </sequence>
    </module>
</config>
