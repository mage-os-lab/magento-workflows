<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Grid-count cache invalidation: the repository is the single write
         chokepoint for every authoring path, so cleaning the count cache tag
         after save/delete keeps the strip's numbers current. Global scope so a
         REST or CLI write invalidates the admin-rendered counts too. -->
    <type name="MageOS\Workflows\Api\WorkflowRepositoryInterface">
        <plugin name="mageos_workflows_invalidate_grid_count_cache"
                type="MageOS\WorkflowsAdminExtension\Plugin\InvalidateCountCache"/>
    </type>

    <!-- Grid coverage map (layout handle => entity type): the extension surface
         for the strip. Each entry has a matching layout file under
         view/adminhtml/layout that injects the strip into that page's
         page.main.actions container; the layout passes entity_type explicitly,
         so this array documents (and lets extensions declare) the coverage set.
         Third parties widen it with one layout file + one entry here.

         Declared globally, not in etc/adminhtml/di.xml: area DI config is layered
         onto the global config with a shallow array_replace() keyed by argument
         name, so an area-scope array argument replaces the global one wholesale
         instead of merging. A third party registering its handle in global di.xml
         would otherwise be silently dropped. -->
    <type name="MageOS\WorkflowsAdminExtension\ViewModel\GridStrip">
        <arguments>
            <argument name="gridHandleMap" xsi:type="array">
                <item name="sales_order_index" xsi:type="string">sales_order</item>
                <item name="customer_index_index" xsi:type="string">customer</item>
                <item name="catalog_product_index" xsi:type="string">catalog_product</item>
                <item name="review_product_index" xsi:type="string">review</item>
                <item name="sales_invoice_index" xsi:type="string">invoice</item>
                <item name="sales_shipment_index" xsi:type="string">shipment</item>
                <item name="sales_creditmemo_index" xsi:type="string">creditmemo</item>
            </argument>
        </arguments>
    </type>
</config>
