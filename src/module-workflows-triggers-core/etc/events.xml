<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Workflow lifecycle -> hidden async-event subscription sync
         (AbstractModel events, event prefix 'mageos_workflow') -->
    <event name="mageos_workflow_save_after">
        <observer name="mageos_workflows_triggers_subscription_sync_save"
                  instance="MageOS\WorkflowsTriggersCore\Observer\WorkflowSaveObserver"/>
    </event>
    <event name="mageos_workflow_delete_after">
        <observer name="mageos_workflows_triggers_subscription_sync_delete"
                  instance="MageOS\WorkflowsTriggersCore\Observer\WorkflowSaveObserver"/>
    </event>

    <!-- Gap-fill async-event publishers all moved to domain packs:
         sales_order_save_after (OrderStatusChangeObserver) to
         mage-os/workflows-sales (domain-packs S1); customer_save_after
         (CustomerGroupChangeObserver) to mage-os/workflows-customer
         (domain-packs S2); review_save_after (ReviewSubmittedObserver) to
         mage-os/workflows-review (domain-packs S5). -->
</config>
