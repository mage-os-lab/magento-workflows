<?xml version="1.0"?>
<!--
/**
 * DI wiring for the trigger layer.
 *
 * Notifier pool: registers WorkflowNotifier under the name "workflow" in the
 * async-events NotifierFactory. The pool argument is `notifierClasses` and its
 * entries are resolved NotifierInterface *instances* (xsi:type="object", not
 * class-name strings) — verified against mage-os/mageos-async-events @ b249976
 * (Service/AsyncEvent/NotifierFactory.php:14,25 takes `array $notifierClasses`
 * and returns `$notifierClasses[$type]` only if it `instanceof NotifierInterface`;
 * upstream etc/di.xml registers the built-in "http" => HttpNotifier the same way).
 * The pool KEY is the subscription's `metadata` value: EventDispatcher resolves
 * the notifier via `$notifierFactory->create($asyncEvent->getMetadata())`
 * (Service/AsyncEvent/EventDispatcher.php:64,66), so SubscriptionManager stamps
 * metadata = "workflow" to route deliveries here.
 *
 * No wiring is required for the core module's workflow_triggers.xml reader
 * quartet (MageOS\Workflows\Model\Trigger\Config\*): Reader, SchemaLocator
 * and Data bind their collaborators, file name and cache id via concrete
 * constructor defaults.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Register the workflow notifier in the async-events notifier pool -->
    <type name="MageOS\AsyncEvents\Service\AsyncEvent\NotifierFactory">
        <arguments>
            <argument name="notifierClasses" xsi:type="array">
                <item name="workflow" xsi:type="object">MageOS\WorkflowsTriggersCore\Model\WorkflowNotifier</item>
            </argument>
        </arguments>
    </type>

    <!-- Refuse out-of-band mutation of workflow-owned subscriptions
         (docs/10-security.md#subscription-ownership) -->
    <type name="MageOS\AsyncEvents\Api\AsyncEventRepositoryInterface">
        <plugin name="mageos_workflows_subscription_ownership"
                type="MageOS\WorkflowsTriggersCore\Plugin\SubscriptionOwnershipPlugin"
                sortOrder="10"/>
    </type>
</config>
