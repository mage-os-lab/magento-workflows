<?xml version="1.0"?>
<!--
/**
 * Trigger metadata for the standard event coverage. The review gap-fill
 * event is declared and published by this module (etc/async_events.xml).
 * The Sales group and the Cart group (quote.abandoned) moved to
 * mage-os/workflows-sales (domain-packs S1); the Customer group to
 * mage-os/workflows-customer (domain-packs S2);
 * inventory.stock_threshold_crossed to mage-os/workflows-inventory
 * (domain-packs S4).
 */
-->
<triggers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_Workflows:etc/workflow_triggers.xsd">
    <!-- Catalog -->
    <trigger event="catalog.product.review_submitted" entity="catalog_product"
             label="Product Review Submitted" group="Catalog"/>
</triggers>
