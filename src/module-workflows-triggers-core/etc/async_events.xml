<!--
/**
 * Gap-fill async event definitions have all moved to the domain packs that
 * own their entity and publisher:
 *   - sales.order.status_changed, quote.abandoned -> mage-os/workflows-sales
 *     (domain-packs S1)
 *   - customer.group_changed -> mage-os/workflows-customer (domain-packs S2)
 *   - inventory.stock_threshold_crossed -> mage-os/workflows-inventory
 *     (domain-packs S4)
 *   - catalog.product.review_submitted -> mage-os/workflows-review
 *     (domain-packs S5)
 *
 * This module now declares no async events of its own; the file is retained
 * as an empty-but-valid config so third parties still see the schema binding
 * and the honesty check no longer attributes catalog/review references here.
 *
 * Node shape verified against mage-os/mageos-async-events @ b249976
 * (etc/async_events.xsd): a required <async_event name="..."> (name pattern
 * [a-zA-Z0-9._-]+, unique) wraps a required <service class="..." method="..."/>
 * (both attributes required) plus an OPTIONAL <resources><resource>…</resource>
 * </resources> block (the ACL gate AsyncEventRepository::save() enforces when
 * $checkResources is true). Same shape mageos-common-async-events ships.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_AsyncEvents:etc/async_events.xsd"/>
