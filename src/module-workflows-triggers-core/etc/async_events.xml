<?xml version="1.0"?>
<!--
/**
 * Gap-fill async event definitions not covered by
 * mage-os/mageos-common-async-events. The service class/method hydrates the
 * delivered payload from the id in the published data; publisher-supplied
 * extra keys (from_status/to_status, from_group_id/to_group_id, review_*)
 * ride along in the message.
 *
 * Publishers: Observer\CustomerGroupChangeObserver,
 * Observer\ReviewSubmittedObserver (this module);
 * inventory.stock_threshold_crossed is published by the scheduler package
 * (mage-os/workflows-scheduler) — declared here so trigger metadata is never
 * dangling. The sales.order.status_changed and quote.abandoned definitions
 * moved to mage-os/workflows-sales (domain-packs S1).
 *
 * Node name assumption: mageos-async-events' async_events.xsd uses
 * <async_event name="..."><service class="..." method="..."/></async_event>
 * (Aligent lineage). If your version's schema uses <event name="...">,
 * rename the nodes here — this file is the only place they appear.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:MageOS_AsyncEvents:etc/async_events.xsd">
    <async_event name="customer.group_changed">
        <service class="Magento\Customer\Api\CustomerRepositoryInterface" method="getById"/>
    </async_event>
    <async_event name="catalog.product.review_submitted">
        <service class="Magento\Catalog\Api\ProductRepositoryInterface" method="getById"/>
    </async_event>
    <async_event name="inventory.stock_threshold_crossed">
        <service class="Magento\Catalog\Api\ProductRepositoryInterface" method="getById"/>
    </async_event>
</config>
