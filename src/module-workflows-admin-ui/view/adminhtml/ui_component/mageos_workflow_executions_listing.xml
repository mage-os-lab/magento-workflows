<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_workflow_executions_listing.mageos_workflow_executions_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>mageos_workflow_executions_columns</spinner>
        <deps>
            <dep>mageos_workflow_executions_listing.mageos_workflow_executions_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_workflow_executions_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">mageos_workflow_executions_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">execution_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <!-- REQUIRED — see mageos_workflows_listing.xml: data-storage keys its
                         record cache by record[indexField] and defaults to 'entity_id',
                         which no row here has, collapsing every record into one slot. -->
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">execution_id</item>
                    </item>
                    <!-- Lets the workflow edit form embed this listing pre-filtered to one
                         workflow ("*" = take from request; absent on the standalone page). -->
                    <item name="filter_url_params" xsi:type="array">
                        <item name="workflow_id" xsi:type="string">*</item>
                    </item>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mageos_workflow_executions_columns">
        <column name="execution_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="uuid">
            <settings>
                <filter>text</filter>
                <label translate="true">UUID</label>
            </settings>
        </column>
        <!-- Fan-out origin correlation (F1): the async-events trace UUID of the
             event that caused this execution. Hidden by default; filtering by
             one source event's UUID returns every child its fan-out produced. -->
        <column name="origin_uuid">
            <settings>
                <filter>text</filter>
                <visible>false</visible>
                <label translate="true">Caused By</label>
            </settings>
        </column>
        <column name="workflow_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Workflow ID</label>
            </settings>
        </column>
        <column name="workflow_name" class="MageOS\WorkflowsAdminUi\Ui\Component\Listing\Column\WorkflowName">
            <settings>
                <label translate="true">Workflow</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="workflow_mode" class="MageOS\WorkflowsAdminUi\Ui\Component\Listing\Column\WorkflowMode">
            <settings>
                <label translate="true">Mode</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="entity_id" class="MageOS\WorkflowsAdminUi\Ui\Component\Listing\Column\ExecutionEntity">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Entity</label>
            </settings>
        </column>
        <column name="store_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Store\Model\System\Store"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Store</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="MageOS\WorkflowsAdminUi\Model\Source\ExecutionStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="trigger_type" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="MageOS\WorkflowsAdminUi\Model\Source\TriggerType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Trigger Type</label>
            </settings>
        </column>
        <column name="mode" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="MageOS\WorkflowsAdminUi\Model\Source\ExecutionMode"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Run Mode</label>
            </settings>
        </column>
        <column name="triggered_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Triggered At</label>
            </settings>
        </column>
        <column name="completed_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Completed At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="MageOS\WorkflowsAdminUi\Ui\Component\Listing\Column\ExecutionActions">
            <settings>
                <indexField>execution_id</indexField>
                <sortable>false</sortable>
                <filter>false</filter>
            </settings>
        </actionsColumn>
    </columns>
</listing>
