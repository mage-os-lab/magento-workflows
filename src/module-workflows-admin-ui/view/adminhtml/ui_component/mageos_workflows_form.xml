<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_workflows_form.mageos_workflows_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <!-- The form template must match the layout builder. This form declares no
             <settings><layout>, so Structure::generate() builds it with the GENERIC
             layout — but the default form template (templates/form/default) binds
             its content to "{name}.areas", a component only the TABS layout builder
             creates (Magento\Ui\Component\Layout\Tabs::initAreas). With the default
             template and no tabs layout, the knockout scope waits forever for a
             component that never registers: the loading mask never hides, not a
             single field renders, and there is no console error. The collapsible
             template binds "{name}.{name}" — the node the generic layout DOES
             create — and renders each fieldset as a collapsible section
             (cms_page_form is the core reference for this exact pattern). -->
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <!-- Toolbar buttons belong to the uiComponent, not to a Widget\Form\Container
             block. Magento_Ui/js/form/adapter binds the form's save/reset handlers to
             the literal selectors '#save' and '#reset' (Magento_Ui/js/form/adapter/buttons),
             and Magento\Ui\Component\Control\Container is what emits those ids. The
             previous container-block Save carried no id and targeted '#edit_form' — a
             legacy adminhtml form id a uiComponent form never renders — so clicking it
             did nothing at all. -->
        <buttons>
            <button name="back" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\BackButton"/>
            <button name="delete" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\DeleteButton"/>
            <button name="dry_run" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\DryRunButton"/>
            <button name="run_now" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\RunNowButton"/>
            <button name="visual_editor" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\VisualEditorButton"/>
            <button name="save" class="MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\Edit\SaveButton"/>
        </buttons>
        <namespace>mageos_workflows_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>mageos_workflows_form.mageos_workflows_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_workflows_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">MageOS\WorkflowsAdminUi\Model\Workflow\DataProvider</argument>
            <argument name="name" xsi:type="string">mageos_workflows_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">workflow_id</argument>
            <argument name="requestFieldName" xsi:type="string">workflow_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
            <!-- Without this the form has nowhere to POST — the provider's client
                 submits to config.submit_url. Declared in the argument/config style
                 (identical config key to <settings><submitUrl>, and the style this
                 dataSource already uses; cf. update_url in the executions listing). -->
            <item name="config" xsi:type="array">
                <item name="submit_url" xsi:type="url" path="mageos_workflows/workflow/save"/>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="workflow_id" formElement="input">
            <settings>
                <visible>false</visible>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <label translate="true">Name</label>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="status" formElement="select" sortOrder="20">
            <settings>
                <label translate="true">Status</label>
                <dataType>text</dataType>
                <dataScope>status</dataScope>
                <notice translate="true">Shadow mode evaluates conditions on live traffic and logs would-be action effects without mutating anything.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\WorkflowsAdminUi\Model\Source\WorkflowStatus"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="entity_type" formElement="select" sortOrder="30">
            <settings>
                <label translate="true">Entity Type</label>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\WorkflowsAdminUi\Model\Source\EntityType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="trigger_type" formElement="select" sortOrder="40">
            <settings>
                <label translate="true">Trigger Type</label>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\WorkflowsAdminUi\Model\Source\TriggerType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="trigger_ref" formElement="select" sortOrder="50">
            <settings>
                <label translate="true">Trigger</label>
                <dataType>text</dataType>
                <notice translate="true">Populated from registered event triggers. For schedule-type workflows, use a cron expression here instead; manual triggers ignore this field.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\WorkflowsAdminUi\Model\Trigger\TriggerRefOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="website_ids" formElement="multiselect" sortOrder="60">
            <settings>
                <label translate="true">Website Scope</label>
                <dataType>text</dataType>
                <dataScope>website_ids</dataScope>
                <notice translate="true">The dispatcher resolves the triggering entity's store to a website and skips this workflow if it doesn't match.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Website"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="loop_guard_depth" formElement="input" sortOrder="70">
            <settings>
                <label translate="true">Loop Guard Depth</label>
                <dataType>number</dataType>
                <notice translate="true">Maximum re-dispatch depth before a self-triggered chain is suppressed (default 1).</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <!-- Trigger-level fan-out (F1). Leaving the relation empty keeps today's
         behavior: one execution per triggering entity. Choosing a relation
         makes the workflow run once PER RELATED ENTITY of the trigger — the
         plain-language preview leads with that per-target phrasing and the cap.
         Save-time alignment (trigger source == relation source, relation
         target == workflow entity type; schedule-type rejected) is enforced by
         FanOutAlignmentCheck. -->
    <fieldset name="fan_out">
        <settings>
            <label translate="true">Fan-Out (run per related entity)</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <field name="fan_out_relation" formElement="select" sortOrder="10">
            <settings>
                <label translate="true">Fan Out Over Relation</label>
                <dataType>text</dataType>
                <notice translate="true">When set, one triggering event runs the workflow once for EACH related entity (e.g. "for each open order of that customer"), up to the cap. The workflow's Entity Type must be the relation's target, and the trigger's entity must be the relation's source. Like a manual mass-run, this may run against many entities per trigger.</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\WorkflowsAdminUi\Model\Source\FanOutRelation"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="fan_out_cap" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Fan-Out Cap</label>
                <dataType>number</dataType>
                <notice translate="true">Maximum related entities to fan out to per trigger. Clamped to the global Fan-Out Cap (Stores → Configuration → Workflows → Guards). Leave blank to use the global cap. Excess targets are dropped with an admin-visible marker.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="conditions">
        <settings>
            <label translate="true">Conditions</label>
            <collapsible>true</collapsible>
        </settings>
        <field name="conditions_serialized" formElement="textarea" sortOrder="10">
            <settings>
                <label translate="true">Conditions</label>
                <dataType>text</dataType>
                <notice translate="true">A serialized condition tree (same shape as salesrule/catalogrule). Use "Edit conditions…" for the slide-out editor, or edit the JSON directly here. Leave blank for "always run".</notice>
            </settings>
        </field>
        <!-- Shared condition slide-out (E1 seam). The textarea above is retained
             as the "edit as JSON" fallback; the slide-out posts the serialized
             tree to the shared Conditions controller. The stock rule widget is
             deferred (E1 spike verdict, docs/11-admin-ui.md) — the slide-out is
             the JSON editor until a full install can host the widget. -->
        <htmlContent name="conditions_editor" sortOrder="20">
            <argument name="block" xsi:type="object">MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\ConditionsEditor</argument>
        </htmlContent>
    </fieldset>
    <fieldset name="actions">
        <settings>
            <label translate="true">Actions</label>
            <collapsible>true</collapsible>
        </settings>
        <field name="definition" formElement="textarea" sortOrder="10">
            <settings>
                <label translate="true">Definition (JSON)</label>
                <dataType>text</dataType>
                <notice translate="true">v1 fallback editor: the raw step-graph JSON (schema, steps, entry -- see docs/04-definition-format.md). Validated on save against the definition schema and against your ACL for every action referenced. A dynamicRows/metadata-driven step builder is a stretch goal.</notice>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <!-- Plain-language preview + save-time validation findings (implementation plan 01,
             stage 3). Server-rendered from the saved definition on load; the block's
             "Refresh preview" button re-runs the F2 pipeline over the unsaved textarea
             content via the admin Preview controller. -->
        <htmlContent name="definition_preview" sortOrder="20">
            <argument name="block" xsi:type="object">MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\DefinitionPreview</argument>
        </htmlContent>
    </fieldset>
    <!-- Embedded executions listing, filtered to the current workflow: the workflow_id from
         the form provider is exported into the external listing provider's request params,
         where the listing data source's filter_url_params picks it up (customer_form/orders
         pattern). Hidden on the new-workflow form via DataProvider::getMeta(). -->
    <fieldset name="execution_log" sortOrder="40">
        <settings>
            <label translate="true">Execution Log</label>
            <collapsible>true</collapsible>
            <opened>false</opened>
        </settings>
        <insertListing name="workflow_executions">
            <settings>
                <dataLinks>
                    <exports>false</exports>
                    <imports>false</imports>
                </dataLinks>
                <externalProvider>mageos_workflow_executions_listing.mageos_workflow_executions_listing_data_source</externalProvider>
                <!-- No <selectionsProvider>: the executions listing is read-only and
                     declares no selectionsColumn, so the old pointer at
                     ...mageos_workflow_executions_columns.ids named a component that
                     never registers. insert-listing.js null-checks it rather than
                     throwing, so it was dead config rather than a hang — but it would
                     silently swallow any future massaction wiring. -->
                <autoRender>true</autoRender>
                <dataScope>workflow_executions</dataScope>
                <ns>mageos_workflow_executions_listing</ns>
                <exports>
                    <link name="workflow_id">${ $.externalProvider }:params.workflow_id</link>
                </exports>
                <imports>
                    <link name="workflow_id">${ $.provider }:data.workflow_id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>
</form>
