<?php
/**
 * @var \MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\DefinitionPreview $block
 *
 * Plain-language preview + validation findings for the workflow edit form.
 * Server-renders the saved definition on load; the "Refresh preview" button
 * re-runs the F2 pipeline over the unsaved textarea content (implementation
 * plan 01, stage 3). No live-keystroke JS.
 *
 * MUST NOT contain an inline script tag. This panel reaches the form through a
 * ui_component htmlContent node, so this rendered HTML is serialized as a JSON
 * string inside the form's text/x-magento-init element — an inline closing
 * script tag here terminates that outer tag at parse time, and the whole form
 * silently fails to initialize (full-page mask, no fields, no console error).
 * The behaviour lives in the mageosWorkflowsDefinitionPreview RequireJS module,
 * booted declaratively below; peer convention: conditions_editor.phtml.
 */
$result = $block->getInitialResult();
$initialText = $result !== null
    ? $result->getPlainLanguage()
    : (string) __('Save the workflow, or use "Refresh preview" below, to see a plain-language summary of this definition.');
$initialMessages = $result !== null ? $result->getMessages() : [];
$mageInit = $block->escapeHtmlAttr('{"mageosWorkflowsDefinitionPreview": {}}');
?>
<div class="mageos-workflows-definition-preview"
     data-mage-init='<?= /* @noEscape */ $mageInit ?>'
     data-refresh-url="<?= $block->escapeUrl($block->getRefreshUrl()) ?>"
     data-form-key="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>">
    <div class="admin__field">
        <label class="admin__field-label">
            <span><?= $block->escapeHtml(__('Plain-language preview')) ?></span>
        </label>
        <div class="admin__field-control">
            <p class="mageos-workflows-preview-text"><?= $block->escapeHtml($initialText) ?></p>
            <div class="mageos-workflows-preview-messages">
                <?php foreach ($initialMessages as $message): ?>
                    <div class="message <?= $message->getSeverity() === 'error' ? 'message-error error' : 'message-warning warning' ?>">
                        <span>
                            <strong><?= $block->escapeHtml($block->getSeverityLabel($message->getSeverity())) ?><?php
                                if ($message->getStepKey() !== null):
                                    ?> &mdash; <?= $block->escapeHtml(__('step "%1"', $message->getStepKey())) ?><?php
                                endif;
                            ?>:</strong>
                            <?= $block->escapeHtml($message->getMessage()) ?>
                        </span>
                    </div>
                <?php endforeach; ?>
            </div>
            <button type="button"
                    class="action-secondary mageos-workflows-preview-refresh"
                    id="mageos-workflows-preview-refresh">
                <span><?= $block->escapeHtml(__('Refresh preview')) ?></span>
            </button>
            <p class="note admin__field-note">
                <span><?= $block->escapeHtml(
                    __('Re-validates the definition above without saving. Errors block saving; warnings do not.')
                ) ?></span>
            </p>
        </div>
    </div>
</div>
