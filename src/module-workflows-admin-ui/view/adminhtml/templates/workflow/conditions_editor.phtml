 * See LICENSE.txt for license details.
 *
 * @var \MageOS\WorkflowsAdminUi\Block\Adminhtml\Workflow\ConditionsEditor $block
 * @var \Magento\Framework\Escaper $escaper
 *
 * The condition slide-out trigger. Booted with data-mage-init (declarative,
 * CSP-safe — no inline script); the STATIC config (apply endpoint, form key,
 * edited field) travels in data-* attributes. The trigger context the slide-out
 * posts for validation (trigger_type / trigger_ref / entity_type) is deliberately
 * NOT emitted here: those three are editable in this very form, so the widget
 * reads them from the live fields at apply time and a mid-edit trigger change is
 * honored (peer convention: definition-preview.js). The textarea (the "edit as
 * JSON" fallback) stays visible above this in the fieldset.
 */
$escaper = $escaper ?? $block->getEscaper();
$config = $escaper->escapeHtmlAttr('{"mageosWorkflowsConditions": {}}');
?>
<div class="mageos-conditions-editor"
     data-mage-init='<?= /* @noEscape */ $config ?>'
     data-apply-url="<?= $escaper->escapeUrl($block->getApplyUrl()) ?>"
     data-form-key="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"
     data-field-selector="<?= $escaper->escapeHtmlAttr($block->getFieldSelector()) ?>">
    <button type="button" class="action-secondary" data-role="open-conditions">
        <?= $escaper->escapeHtml(__('Edit conditions…')) ?>
    </button>
    <span class="note">
        <?= $escaper->escapeHtml(__('Opens a slide-out editor. The textarea above remains available for direct JSON editing.')) ?>
    </span>
</div>
