<?php
/**
 * @var \MageOS\WorkflowsAdminUi\Block\Adminhtml\Template\Install $block
 *
 * Every widget the block can return has its OWN branch below — none falls
 * through to a default — so adding a widget without rendering it fails the
 * view contract test rather than silently degrading a field. The two enhanced
 * widgets (search, duration) always render their REAL input inside the
 * container and boot declaratively with data-mage-init, all config in data-*
 * attributes: with JavaScript off, or after an install error re-renders the
 * form, the plain input is what the operator gets. No inline script (CSP).
 */
$parameters = $block->getParameters();
$searchInit = $block->escapeHtmlAttr('{"mageosWorkflowsParamSearch": {}}');
$durationInit = $block->escapeHtmlAttr('{"mageosWorkflowsParamDuration": {}}');
?>
<div class="admin__page-section">
    <div class="admin__page-section-title">
        <span class="title"><?= $block->escapeHtml(__('Install: %1', $block->getTitle())) ?></span>
    </div>
    <p class="admin__field-note">
        <?= $block->escapeHtml(__('The workflow is created disabled (or in shadow mode). Nothing runs against real orders or customers until you review and enable it.')) ?>
    </p>

    <form action="<?= $block->escapeUrl($block->getFormActionUrl()) ?>" method="post" id="mageos-template-install-form">
        <?= $block->getBlockHtml('formkey') ?>
        <input type="hidden" name="install" value="1"/>

        <?php foreach ($parameters as $parameter): ?>
            <?php
            $key = (string) ($parameter['key'] ?? '');
            $widget = $block->widget($parameter);
            $note = $block->fieldNote($parameter);
            $fieldId = 'mageos-param-' . $key;
            ?>
            <div class="admin__field<?= $block->isRequired($parameter) ? ' _required' : '' ?>">
                <label class="admin__field-label" for="<?= $block->escapeHtmlAttr($fieldId) ?>">
                    <span><?= $block->escapeHtml($block->fieldLabel($parameter)) ?></span>
                </label>
                <div class="admin__field-control">
                    <?php if ($widget === 'select'): ?>
                        <select id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                                name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                                class="admin__control-select"<?= $block->isRequired($parameter) ? ' required' : '' ?>>
                            <?php foreach ($block->options($parameter) as $option): ?>
                                <option value="<?= $block->escapeHtmlAttr($option['value']) ?>"
                                    <?= $block->fieldValue($parameter) === $option['value'] ? 'selected' : '' ?>>
                                    <?= $block->escapeHtml($option['label']) ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                    <?php elseif ($widget === 'secret'): ?>
                        <input type="text" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                               name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                               class="admin__control-text"
                               value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                               placeholder="<?= $block->escapeHtmlAttr(__('secret name')) ?>"/>
                        <input type="password" name="secret_value[<?= $block->escapeHtmlAttr($key) ?>]"
                               class="admin__control-text" autocomplete="new-password"
                               placeholder="<?= $block->escapeHtmlAttr(__('new value (optional)')) ?>"/>
                    <?php elseif ($widget === 'search'): ?>
                        <?php $search = $block->searchConfig($parameter); ?>
                        <div class="mageos-param-search"
                             data-mage-init='<?= /* @noEscape */ $searchInit ?>'
                             data-endpoint="<?= $block->escapeUrl($search['url']) ?>"
                             data-source="<?= $block->escapeHtmlAttr($search['source']) ?>"
                             data-min-chars="<?= $block->escapeHtmlAttr((string) $search['min_chars']) ?>"
                             data-current-label="<?= $block->escapeHtmlAttr($block->currentValueLabel($parameter)) ?>"
                             data-search-placeholder="<?= $block->escapeHtmlAttr(__('Type to search…')) ?>"
                             data-label-results="<?= $block->escapeHtmlAttr(__('Search results')) ?>"
                             data-label-no-results="<?= $block->escapeHtmlAttr(__('No matches.')) ?>"
                             data-label-nothing-selected="<?= $block->escapeHtmlAttr(__('Nothing selected yet.')) ?>"
                             data-label-manual="<?= $block->escapeHtmlAttr(__('Enter the record ID manually')) ?>">
                            <input type="text" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                                   name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                                   class="admin__control-text"
                                   value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                                   <?= $block->isRequired($parameter) ? 'required' : '' ?>/>
                        </div>
                    <?php elseif ($widget === 'duration'): ?>
                        <?php $duration = $block->durationParts($parameter); ?>
                        <div class="mageos-param-duration"
                             data-mage-init='<?= /* @noEscape */ $durationInit ?>'
                             <?php if ($duration !== null): ?>
                             data-value="<?= $block->escapeHtmlAttr((string) $duration['value']) ?>"
                             data-unit="<?= $block->escapeHtmlAttr($duration['unit']) ?>"
                             <?php endif; ?>
                             data-label-amount="<?= $block->escapeHtmlAttr(__('Amount')) ?>"
                             data-label-unit="<?= $block->escapeHtmlAttr(__('Unit')) ?>"
                             data-label-minutes="<?= $block->escapeHtmlAttr(__('Minutes')) ?>"
                             data-label-hours="<?= $block->escapeHtmlAttr(__('Hours')) ?>"
                             data-label-days="<?= $block->escapeHtmlAttr(__('Days')) ?>">
                            <input type="text" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                                   name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                                   class="admin__control-text"
                                   value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                                   <?= $block->isRequired($parameter) ? 'required' : '' ?>/>
                        </div>
                    <?php elseif ($widget === 'number'): ?>
                        <input type="number" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                               name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                               class="admin__control-text"
                               value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                               <?php foreach ($block->numberAttrs($parameter) as $attribute => $attributeValue): ?>
                               <?= $block->escapeHtmlAttr($attribute) ?>="<?= $block->escapeHtmlAttr($attributeValue) ?>"
                               <?php endforeach; ?>
                               <?= $block->isRequired($parameter) ? 'required' : '' ?>/>
                    <?php elseif ($widget === 'url'): ?>
                        <input type="url" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                               name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                               class="admin__control-text"
                               value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                               <?= $block->isRequired($parameter) ? 'required' : '' ?>/>
                    <?php elseif ($widget === 'text'): ?>
                        <input type="text" id="<?= $block->escapeHtmlAttr($fieldId) ?>"
                               name="param[<?= $block->escapeHtmlAttr($key) ?>]"
                               class="admin__control-text"
                               value="<?= $block->escapeHtmlAttr($block->fieldValue($parameter)) ?>"
                               <?= $block->isRequired($parameter) ? 'required' : '' ?>/>
                    <?php endif; ?>
                    <?php if ($note !== null): ?>
                        <div class="admin__field-note"><span><?= $block->escapeHtml($note) ?></span></div>
                    <?php endif; ?>
                </div>
            </div>
        <?php endforeach; ?>

        <div class="admin__field">
            <div class="admin__field-control">
                <label class="admin__field-label" for="mageos-install-shadow">
                    <input type="checkbox" id="mageos-install-shadow" name="install_shadow" value="1"
                        <?= $block->isShadowChecked() ? 'checked' : '' ?>/>
                    <span><?= $block->escapeHtml(__('Install in shadow mode (recommended): it evaluates and logs but performs no side effects until you enable it.')) ?></span>
                </label>
            </div>
        </div>

        <div class="admin__field">
            <div class="admin__field-control">
                <a class="action-default" href="<?= $block->escapeUrl($block->getBackUrl()) ?>">
                    <?= $block->escapeHtml(__('Cancel')) ?>
                </a>
                <button type="submit" class="action-primary">
                    <span><?= $block->escapeHtml(__('Install workflow')) ?></span>
                </button>
            </div>
        </div>
    </form>
</div>
