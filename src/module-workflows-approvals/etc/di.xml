<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Data + service contracts -->
    <preference for="MageOS\WorkflowsApprovals\Api\Data\ApprovalInterface"
                type="MageOS\WorkflowsApprovals\Model\Approval"/>
    <preference for="MageOS\WorkflowsApprovals\Api\Data\ApprovalSearchResultsInterface"
                type="MageOS\WorkflowsApprovals\Model\ApprovalSearchResults"/>
    <preference for="MageOS\WorkflowsApprovals\Api\Data\ApprovalDecisionResultInterface"
                type="MageOS\WorkflowsApprovals\Model\ApprovalDecisionResult"/>
    <preference for="MageOS\WorkflowsApprovals\Api\ApprovalRepositoryInterface"
                type="MageOS\WorkflowsApprovals\Model\ApprovalRepository"/>
    <preference for="MageOS\WorkflowsApprovals\Api\ApprovalManagementInterface"
                type="MageOS\WorkflowsApprovals\Model\ApprovalManagement"/>

    <!-- Role-enforcement seam (§5, §6 Stage 3): real Magento role/ACL checking,
         backed by the authorization_role / authorization_rule tables (see
         RoleTableAuthorization's docblock for the pinned schema assumptions).
         One global binding covers both areas ApprovalService::decide() is
         called from (adminhtml Decide controller, webapi ApprovalManagement) —
         it is the single shared decision path, so there is no per-area
         behavioral difference to bind separately. DenyRoleAuthorization remains
         in the module as the documented deny-safe fallback shape; it is simply
         no longer the bound default now that the real check is wired. -->
    <preference for="MageOS\WorkflowsApprovals\Api\ApprovalAuthorizationInterface"
                type="MageOS\WorkflowsApprovals\Model\Authorization\RoleTableAuthorization"/>

    <!-- The core task seam (docs/discovery/approval-gate.md §7): binding the
         implementation here is what turns approval steps from unauthorable
         (save-time APPROVAL_MODULE_MISSING) into a live feature. -->
    <preference for="MageOS\Workflows\Api\ApprovalTaskManagerInterface"
                type="MageOS\WorkflowsApprovals\Model\ApprovalTaskManager"/>

    <!--
        The core seam is an OPTIONAL (nullable) constructor argument on every
        consumer (Executor, ResumeConsumer, ApprovalCheck) so core installs
        without this addon. A <preference> alone does NOT fill a nullable
        optional argument that defaults to null — the object manager leaves the
        default in place. Each consumer must be wired explicitly (Stage 1
        finding) or the addon would install and still behave as if absent.
    -->
    <type name="MageOS\Workflows\Model\Engine\Executor">
        <arguments>
            <argument name="approvalTaskManager" xsi:type="object">MageOS\WorkflowsApprovals\Model\ApprovalTaskManager</argument>
        </arguments>
    </type>
    <type name="MageOS\Workflows\Model\Queue\ResumeConsumer">
        <arguments>
            <argument name="approvalTaskManager" xsi:type="object">MageOS\WorkflowsApprovals\Model\ApprovalTaskManager</argument>
        </arguments>
    </type>
    <type name="MageOS\Workflows\Model\Validation\Check\ApprovalCheck">
        <arguments>
            <argument name="approvalTaskManager" xsi:type="object">MageOS\WorkflowsApprovals\Model\ApprovalTaskManager</argument>
        </arguments>
    </type>

    <!-- Grid data source: independent SearchResult scan over the raw table,
         same convention as admin-ui's own grid virtualTypes.

         MUST live in global etc/di.xml, never etc/adminhtml/di.xml. Area DI config is
         layered onto the global config by Magento\Framework\ObjectManager\Config\Config
         using array_replace() — a SHALLOW replace keyed by argument name. An area-scope
         `collections` argument therefore replaces the whole global map rather than
         merging into it, unregistering every core grid (customer_listing_data_source,
         sales_order_grid_data_source, ...) and breaking the native admin grids with
         "Not registered handle <name>". Core registers these globally for this reason. -->
    <virtualType name="MageOS\WorkflowsApprovals\Model\ResourceModel\Approval\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">mageos_workflow_approval</argument>
            <argument name="resourceModel" xsi:type="string">MageOS\WorkflowsApprovals\Model\ResourceModel\Approval</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mageos_workflow_approvals_listing_data_source" xsi:type="string">MageOS\WorkflowsApprovals\Model\ResourceModel\Approval\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!-- Entity deep-link map (docs/discovery/approval-gate.md §6 grid + decision
         view): the DI-registered extensibility surface, same convention as
         MageOS\WorkflowsAdminExtension\ViewModel\GridStrip's $gridHandleMap — a
         third party widens coverage with one entry, no code change. Covers the
         native entity types the admin-extension grid strip already lists.
         Global scope for the same array_replace reason as above: a third party
         declaring routes in global di.xml must not be wiped by an area-scope
         declaration here. -->
    <type name="MageOS\WorkflowsApprovals\Model\EntityUrlResolver">
        <arguments>
            <argument name="entityRouteMap" xsi:type="array">
                <item name="sales_order" xsi:type="array">
                    <item name="route" xsi:type="string">sales/order/view</item>
                    <item name="param" xsi:type="string">order_id</item>
                </item>
                <item name="customer" xsi:type="array">
                    <item name="route" xsi:type="string">customer/index/edit</item>
                    <item name="param" xsi:type="string">id</item>
                </item>
                <item name="catalog_product" xsi:type="array">
                    <item name="route" xsi:type="string">catalog/product/edit</item>
                    <item name="param" xsi:type="string">id</item>
                </item>
                <item name="invoice" xsi:type="array">
                    <item name="route" xsi:type="string">sales/order_invoice/view</item>
                    <item name="param" xsi:type="string">invoice_id</item>
                </item>
                <item name="shipment" xsi:type="array">
                    <item name="route" xsi:type="string">sales/order_shipment/view</item>
                    <item name="param" xsi:type="string">shipment_id</item>
                </item>
                <item name="creditmemo" xsi:type="array">
                    <item name="route" xsi:type="string">sales/order_creditmemo/view</item>
                    <item name="param" xsi:type="string">creditmemo_id</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Park notification (§6): the gate owns this because only the gate knows
         the task uuid (createTask's return value). An `around` plugin on the
         INTERFACE (not the concrete ApprovalTaskManager) so any future
         alternate implementation still gets notified — see
         Plugin\Notification\NotifyOnTaskCreation's docblock for why `around`
         (redelivery/idempotency) rather than `after`. -->
    <type name="MageOS\Workflows\Api\ApprovalTaskManagerInterface">
        <plugin name="mageos_workflows_approvals_notify_on_task_creation"
                type="MageOS\WorkflowsApprovals\Plugin\Notification\NotifyOnTaskCreation"/>
    </type>
</config>
