<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The grid data source and the entity deep-link map are declared in the module's
         global etc/di.xml, NOT here: area DI is layered onto global config with a
         shallow array_replace(), so an array argument declared in this scope replaces
         the global one wholesale instead of merging into it. See etc/di.xml. -->

    <!-- Mass actions operate on the full domain collection, same convention as
         admin-ui's Workflow MassEnable/MassDisable. Scalar object arguments,
         safe to bind per-area. -->
    <type name="MageOS\WorkflowsApprovals\Controller\Adminhtml\Approval\MassApprove">
        <arguments>
            <argument name="collectionFactory" xsi:type="object">MageOS\WorkflowsApprovals\Model\ResourceModel\Approval\CollectionFactory</argument>
        </arguments>
    </type>
    <type name="MageOS\WorkflowsApprovals\Controller\Adminhtml\Approval\MassReject">
        <arguments>
            <argument name="collectionFactory" xsi:type="object">MageOS\WorkflowsApprovals\Model\ResourceModel\Approval\CollectionFactory</argument>
        </arguments>
    </type>
</config>
