/vendor/
composer.lock
# phpstan: CI/local overlay binding the config to a Magento install, and the
# baseline the CI job regenerates (see phpstan.neon.dist).
/phpstan-ci.neon
/phpstan-baseline.generated.neon
.idea/
.vscode/
*.swp
.DS_Store
# Local agent state stays untracked. The two entries under .claude/skills/ are
# checked-in symlinks to the canonical skills in
# src/module-workflows/.agents/skills/, so a checkout picks them up with no setup.
/.claude/*
!/.claude/skills/
