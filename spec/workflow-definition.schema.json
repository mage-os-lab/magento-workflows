{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mage-os.org/schemas/workflow-definition/2.json",
    "title": "Mage-OS Workflow Definition",
    "description": "Step-graph definition consumed by the executor, form UI, canvas, and import/export. Version 2 adds the wait step and the optional delay fields business_days / at; documents using them MUST declare schema 2. Version 1 documents remain valid.",
    "type": "object",
    "required": ["schema", "steps", "entry"],
    "additionalProperties": false,
    "properties": {
        "schema": {
            "enum": [1, 2]
        },
        "entry": {
            "$ref": "#/$defs/stepKeyOrNull",
            "description": "Key of the first step; null only when steps is empty"
        },
        "steps": {
            "type": "object",
            "propertyNames": {
                "pattern": "^[a-zA-Z0-9_\\-]{1,64}$"
            },
            "additionalProperties": {
                "oneOf": [
                    {"$ref": "#/$defs/actionStep"},
                    {"$ref": "#/$defs/delayStep"},
                    {"$ref": "#/$defs/branchStep"},
                    {"$ref": "#/$defs/stopStep"},
                    {"$ref": "#/$defs/waitStep"}
                ]
            }
        }
    },
    "$defs": {
        "stepKeyOrNull": {
            "oneOf": [
                {"type": "string", "pattern": "^[a-zA-Z0-9_\\-]{1,64}$"},
                {"type": "null"}
            ]
        },
        "iso8601Duration": {
            "type": "string",
            "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
        },
        "actionStep": {
            "type": "object",
            "required": ["type", "action"],
            "additionalProperties": false,
            "properties": {
                "type": {"const": "action"},
                "action": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
                    "description": "Registered action code, e.g. order.add_comment. Static: never interpolated."
                },
                "config": {
                    "type": "object",
                    "description": "Action config. String values may contain {{ trigger.* }}, {{ steps.* }}, {{ workflow.* }}, {{ secrets.* }} placeholders (values only, never keys), optionally with whitelisted formatters, e.g. {{ trigger.grand_total|number:2 }}."
                },
                "next": {"$ref": "#/$defs/stepKeyOrNull"}
            }
        },
        "delayStep": {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "properties": {
                "type": {"const": "delay"},
                "config": {
                    "type": "object",
                    "required": ["duration"],
                    "additionalProperties": false,
                    "properties": {
                        "duration": {
                            "$ref": "#/$defs/iso8601Duration",
                            "description": "ISO-8601 duration; absolute UTC arithmetic unless business_days/at are set"
                        },
                        "business_days": {
                            "type": "boolean",
                            "default": false,
                            "description": "Schema 2 only. Day components count Mon-Fri in the store's timezone."
                        },
                        "at": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                            "description": "Schema 2 only. After the duration, roll forward to the next occurrence of this store-local time (24h HH:MM)."
                        }
                    }
                },
                "next": {"$ref": "#/$defs/stepKeyOrNull"}
            }
        },
        "branchStep": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
                "type": {"const": "branch"},
                "conditions_serialized": {
                    "type": "string",
                    "description": "Rule condition tree, salesrule-compatible serialized format"
                },
                "revalidate_entity": {
                    "type": "boolean",
                    "default": true,
                    "description": "true: re-hydrate the entity fresh before evaluating (correct default after delays); false: evaluate against the frozen trigger snapshot"
                },
                "on_true": {"$ref": "#/$defs/stepKeyOrNull"},
                "on_false": {"$ref": "#/$defs/stepKeyOrNull"}
            }
        },
        "stopStep": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
                "type": {"const": "stop"}
            }
        },
        "waitStep": {
            "type": "object",
            "required": ["type", "config"],
            "additionalProperties": false,
            "description": "Schema 2 only. Parks the execution until the named trigger event fires for the same entity, or until the timeout elapses. The resume routes through on_event / on_timeout; the step's output exposes {resolution: 'event'|'timeout', event: <payload>} for downstream interpolation.",
            "properties": {
                "type": {"const": "wait"},
                "config": {
                    "type": "object",
                    "required": ["event", "timeout"],
                    "additionalProperties": false,
                    "properties": {
                        "event": {
                            "type": "string",
                            "pattern": "^[a-z0-9_.\\-]{1,128}$",
                            "description": "Trigger event name to wait for (matched against this execution's entity id)"
                        },
                        "timeout": {
                            "$ref": "#/$defs/iso8601Duration",
                            "description": "Timeout after which on_timeout fires; ceiling-clamped by the max-delay guard"
                        }
                    }
                },
                "on_event": {"$ref": "#/$defs/stepKeyOrNull"},
                "on_timeout": {"$ref": "#/$defs/stepKeyOrNull"}
            }
        }
    }
}
