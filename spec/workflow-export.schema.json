{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mage-os.org/schemas/workflow-export/1.json",
    "title": "Mage-OS Workflow Export Envelope",
    "description": "bin/magento workflow:export output / workflow:import input. Never contains secret values.",
    "type": "object",
    "required": ["format", "name", "entity_type", "trigger_type", "trigger_ref", "definition"],
    "additionalProperties": false,
    "properties": {
        "format": {"const": "mageos-workflow-export/1"},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "entity_type": {"type": "string"},
        "trigger_type": {"enum": ["event", "schedule", "manual"]},
        "trigger_ref": {"type": "string"},
        "conditions_serialized": {"type": ["string", "null"]},
        "definition": {"$ref": "https://mage-os.org/schemas/workflow-definition/1.json"},
        "loop_guard_depth": {"type": "integer", "minimum": 0, "maximum": 10, "default": 1}
    }
}
